{
  "manifest_version": 3,
  "name": "FM Rush — HeneFM Deal Scanner",
  "version": "24.56.0",
  "description": "Passively watches live HeneFM listings and sends them to FM Rush. No automatic HeneFM refresh.",
  "permissions": [
    "storage",
    "alarms",
    "debugger",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:18773/*",
    "https://henefm.com/*",
    "https://www.henefm.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://henefm.com/flips*",
        "https://www.henefm.com/flips*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FM Rush — live scanner",
    "default_popup": "popup.html"
  }
}
